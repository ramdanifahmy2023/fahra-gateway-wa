{
  "name": "@ocgw/baileys-service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "node clean.mjs dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test --max-warnings=0",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "node clean.mjs dist/.test && tsc -p tsconfig.test.json && node --test dist/.test/test/*.test.js"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "pg": "^8.16.3",
    "pino": "^9.9.5",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "@types/pg": "^8.15.5",
    "@types/qrcode": "^1.5.5",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
