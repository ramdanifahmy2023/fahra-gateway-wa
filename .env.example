# Workspace
NODE_ENV=production
LOG_LEVEL=info
HOST=127.0.0.1
GATEWAY_PORT=3100
DASHBOARD_PORT=3200
DATA_DIR=./data

# PostgreSQL discovery-first (required). The installer never installs a server.
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/openclaw_gateway
# Leave empty for ordinary direct URLs. Set to direct/session only when the
# provider explicitly confirms session affinity; transaction pooling is unsafe.
DATABASE_POOL_MODE=
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# Redis is optional. If empty/unreachable, the durable PostgreSQL queue is used.
REDIS_URL=

# Generate JWT/internal keys with 48 bytes and encryption keys with exactly 32 bytes.
# Example encryption key: openssl rand -base64 32
JWT_SECRET=
INTERNAL_API_KEY=
SESSION_ENCRYPTION_KEY=
WHATSAPP_SESSION_ENCRYPTION_KEY=
BACKUP_ENCRYPTION_KEY=

# Bootstrap account; password change is forced on first login.
BOOTSTRAP_ADMIN_EMAIL=ramdanifahmy2023@gmail.com
# Generate a unique value: openssl rand -base64 48
BOOTSTRAP_ADMIN_PASSWORD=

# Localhost-only OpenClaw bridge
OPENCLAW_WEBHOOK_URL=http://127.0.0.1:18789/v1/chat/completions
OPENCLAW_HEALTH_URL=http://127.0.0.1:18789/health
OPENCLAW_API_KEY=
OPENCLAW_TIMEOUT_MS=90000
OPENCLAW_REPLY_DELAY_MS=26000

# Gateway service-to-service URL
GATEWAY_INTERNAL_URL=http://127.0.0.1:3100

# Outbound Cloudflare Tunnel. Never commit the token.
CLOUDFLARE_TUNNEL_TOKEN=
CLOUDFLARE_HOSTNAME=

# Optional runtime tuning
QUEUE_POLL_MS=1000
QUEUE_LEASE_SECONDS=60
WHATSAPP_QR_TTL_SECONDS=60
WHATSAPP_MAX_RECONNECT_DELAY_MS=60000
UPLOAD_MAX_BYTES=26214400
TRUST_PROXY=false
